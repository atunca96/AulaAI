worker.log

# Debug/scratch files
server_debug*.txt
scratch/
# Don't ignore requirements.txt
!requirements.txt

# Local dev archives
*.zip

# Python cache
__pycache__/
*.pyc
*.pyo

# IDE
.vscode/
.idea/
